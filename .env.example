############################################
# Telegram — нужны ДВА разных бота
############################################
# 1) User bot: пользователи пишут сюда. n8n принимает webhook с этого токена.
TELEGRAM_USER_BOT_TOKEN=123456:USER_BOT_TOKEN

# 2) Group bot: админ в форум-группе, создаёт топики. Этот сервис крутит polling на нём.
TELEGRAM_GROUP_BOT_TOKEN=789012:GROUP_BOT_TOKEN

# ID Telegram-группы с включёнными Topics (обычно -100...)
TELEGRAM_GROUP_ID=-1001234567890

############################################
# Redis (ключи между n8n и group-ботом)
############################################
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=support_bot
TOGGLE_AI_TIMEOUT_SEC=10

############################################
# Postgres поддержки (диалоги / сообщения / топики)
############################################
POSTGRES_DB=supportbot
POSTGRES_USER=supportbot
POSTGRES_PASSWORD=change_me_long_random_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

############################################
# Иконки топиков (custom emoji id)
# 🤖 AI on / 💻 AI off
############################################
ICON_AI_ENABLED=5309832892262654231
ICON_AI_DISABLED=5350554349074391003

############################################
# Кабинет Bedolaga (кнопка «Карточка пользователя» в n8n)
############################################
CABINET_URL=https://cab.example.com

############################################
# Readonly-доступ к БД Bedolaga (для карточки пользователя в n8n)
# Сначала выполни scripts/setup-bedolaga-readonly.sql на сервере Bedolaga
############################################
BEDOLAGA_DB_HOST=bedolaga-db.example.com
BEDOLAGA_DB_PORT=5432
BEDOLAGA_DB_NAME=remnawave_bot
BEDOLAGA_DB_USER=n8n_readonly
BEDOLAGA_DB_PASSWORD=change_me_readonly_password

############################################
# n8n
############################################
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

############################################
# Общее
############################################
TZ=Europe/Moscow
