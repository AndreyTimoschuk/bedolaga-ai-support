############################################
# E2E / contract test env (copy to .env.test)
############################################

# User bot (webhook / n8n) — @lbrts_cicd1_bot
TELEGRAM_USER_BOT_TOKEN=CHANGE_ME_USER_BOT_TOKEN

# Group bot (polling / this service) — @lbrts_cicd2_bot
TELEGRAM_GROUP_BOT_TOKEN=CHANGE_ME_GROUP_BOT_TOKEN

# Forum group with Topics enabled
TELEGRAM_GROUP_ID=-1004468155541

# Real Telegram user who pressed /start on the user bot and is in the group
TEST_USER_CHAT_ID=CHANGE_ME_USER_CHAT_ID

REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=support_bot_test
TOGGLE_AI_TIMEOUT_SEC=10
TEST_MODE=true

POSTGRES_DB=supportbot
POSTGRES_USER=supportbot
POSTGRES_PASSWORD=e2e_support_password_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Host ports (pytest connects here)
TEST_REDIS_PORT=6380
TEST_POSTGRES_PORT=5433

ICON_AI_ENABLED=5309832892262654231
ICON_AI_DISABLED=5350554349074391003
CABINET_URL=https://cab.example.com

BEDOLAGA_DB_HOST=
BEDOLAGA_DB_PORT=5432
BEDOLAGA_DB_NAME=remnawave_bot
BEDOLAGA_DB_USER=n8n_readonly
BEDOLAGA_DB_PASSWORD=

# Optional for AI path; e2e core tests keep AI off
OPENAI_API_KEY=sk-proj-CHANGE_ME

N8N_HOST=localhost
N8N_PORT=5679
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5679/
N8N_EDITOR_BASE_URL=http://localhost:5679/
N8N_SECURE_COOKIE=false
N8N_TELEGRAM_WEBHOOK_ID=a1b2c3d4-e5f6-7890-abcd-ef1234567890
N8N_ENCRYPTION_KEY=support-e2e-encryption-key-32b

# n8n owner used by bootstrap (created on first run)
N8N_OWNER_EMAIL=e2e@example.com
N8N_OWNER_PASSWORD=E2eOwnerPass123!
N8N_OWNER_FIRST_NAME=E2E
N8N_OWNER_LAST_NAME=Owner

TZ=Europe/Moscow
